<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <application>
    <!-- Captures the application context before any Dart code runs, so the
         MIDI isolate can reach MidiManager without a platform channel. -->
    <provider
      android:name="com.audanika.aud_midi_android.AudMidiContextProvider"
      android:authorities="${applicationId}.aud_midi_android"
      android:exported="false"
      android:initOrder="100" />
  </application>
</manifest>
