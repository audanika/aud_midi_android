{
  "name": "aud_midi_android",
  "summary": "The Android backend of aud_midi: android.media.midi through JNI, AMidi through FFI, plus a small Java shim.",
  "domain": [
    "Android MIDI backend"
  ],
  "interfaces": {
    "uses": {
      "aud_midi_core": "backend contracts",
      "aud_midi_standard": "models"
    },
    "usedBy": {
      "aud_midi": "consumes this package"
    }
  }
}
